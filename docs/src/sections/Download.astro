---
/*
  Section 08 — 选择你的平台
  - 5 个平台 tile（Win / macOS / Linux / Android / iOS）
  - Phase 8 会接入 GitHub Releases API；当前用 placeholder 数据
*/
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { withBase } from "../lib/url";
import {
  loadReleases,
  groupDesktopAssetsByPlatform,
  formatPublishedAt,
} from "../lib/releases";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const releases = await loadReleases();
const latestDesktop = releases.desktop.latest;
const latestMobile = releases.mobile.latest;
const desktopAssets = groupDesktopAssetsByPlatform(latestDesktop);
const androidApk = latestMobile?.assets.find((a) => a.platform === "android") ?? null;

const RELEASE = {
  version: latestDesktop?.version ?? "0.3.1",
  publishedAt: formatPublishedAt(latestDesktop?.publishedAt ?? "", lang),
  url: latestDesktop?.url ?? "https://github.com/swarm-apps/SwarmNote/releases",
};

const subtitleTemplate = t("download.subtitleTemplate")
  .replace("{version}", `v${RELEASE.version}`)
  .replace("{publishedAt}", RELEASE.publishedAt || "—");

const platformsLabel = (t as unknown as (k: string) => unknown)(
  "download.platforms",
) as Record<string, string>;

type Platform = {
  key: "windows" | "macos" | "linux" | "android" | "ios";
  available: boolean;
  link: string;
  fileHint?: string;
  /** 该平台版本号（Android 走 mobile repo，与桌面端不同） */
  version?: string;
  pendingMsg?: string;
  pendingLinkLabel?: string;
};

function fileHint(assets: typeof desktopAssets.windows): string | undefined {
  if (!assets.length) return undefined;
  const exts = Array.from(
    new Set(assets.map((a) => `.${a.name.split(".").pop()?.toLowerCase()}`)),
  ).slice(0, 2);
  return exts.join(" · ");
}

function bestDownloadLink(
  assets: typeof desktopAssets.windows,
): string | undefined {
  return assets[0]?.downloadUrl;
}

const winAvailable = desktopAssets.windows.length > 0;
const macAvailable = desktopAssets.macos.length > 0;
const linuxAvailable = desktopAssets.linux.length > 0;

const platforms: Platform[] = [
  {
    key: "windows",
    available: winAvailable,
    link: bestDownloadLink(desktopAssets.windows) ?? RELEASE.url,
    fileHint: fileHint(desktopAssets.windows) ?? ".msi · x64",
    version: RELEASE.version,
  },
  {
    key: "macos",
    available: macAvailable,
    link: bestDownloadLink(desktopAssets.macos) ?? RELEASE.url,
    fileHint: fileHint(desktopAssets.macos) ?? ".dmg · universal",
    version: RELEASE.version,
  },
  {
    key: "linux",
    available: linuxAvailable,
    link: bestDownloadLink(desktopAssets.linux) ?? RELEASE.url,
    fileHint: fileHint(desktopAssets.linux) ?? ".AppImage · .deb",
    version: RELEASE.version,
  },
  {
    key: "android",
    available: !!androidApk,
    link: androidApk?.downloadUrl ?? "https://github.com/swarm-apps/SwarmNote-RN/releases",
    fileHint: androidApk ? ".apk · arm64/x64" : undefined,
    version: latestMobile?.version,
    pendingMsg: t("download.android.placeholder"),
    pendingLinkLabel: t("download.android.linkLabel"),
  },
  {
    key: "ios",
    available: false,
    link: "https://github.com/swarm-apps/SwarmNote-RN",
    pendingMsg: t("download.ios.placeholder"),
    pendingLinkLabel: t("download.ios.linkLabel"),
  },
];

// Lucide-style SVG path data per platform
const ICON_PATHS: Record<Platform["key"], string> = {
  windows:
    "M3 3h8v8H3z M13 3h8v8h-8z M3 13h8v8H3z M13 13h8v8h-8z",
  macos:
    "M12 2.5c-.6 0-1 .4-1 1 0 .9-.4 1.7-1 2.3-.7.6-1.6 1-2.5 1-.5 0-1 .4-1 1 0 1.4.5 2.7 1.5 3.7s2.3 1.5 3.7 1.5c1.4 0 2.7-.5 3.7-1.5s1.5-2.3 1.5-3.7c0-.6-.4-1-1-1-.9 0-1.7-.4-2.3-1-.7-.6-1-1.4-1-2.3 0-.5-.4-1-1-1z M8 14c-2 0-4 1.5-4 5 0 1 .3 2 1 2.5.3.2.7 0 .9-.3.4-.6 1.4-1.2 2.5-1.2.7 0 1.4.2 2 .6.3.2.7.2 1 0 .6-.4 1.3-.6 2-.6 1.1 0 2.1.6 2.5 1.2.2.3.6.5.9.3.7-.5 1-1.5 1-2.5 0-3.5-2-5-4-5-1 0-2 .5-2.5 1-.5-.5-1.5-1-2.5-1z",
  linux:
    "M9 4c-1 0-2 1-2 2.5 0 1 .5 2 1 2.5-1.5 1-3 3-3 6.5 0 1.5 1 3 2 4 0 .5-.5 1-1 1-.5 0-1 .5-1 1h12c0-.5-.5-1-1-1-.5 0-1-.5-1-1 1-1 2-2.5 2-4 0-3.5-1.5-5.5-3-6.5.5-.5 1-1.5 1-2.5C15 5 14 4 13 4h-4z M10 8a1 1 0 1 1 0 0 M14 8a1 1 0 1 1 0 0",
  android:
    "M5 16V9a7 7 0 0 1 14 0v7 M5 16h14 M5 16a2 2 0 0 0 0 4h14a2 2 0 0 0 0-4 M9 7l-2-3 M15 7l2-3 M9 12h.01 M15 12h.01",
  ios:
    "M14 4h.01 M16 8a4 4 0 0 0-4 4 M19 12a7 7 0 1 1-14 0 7 7 0 0 1 14 0z M9 8.5l-.5-.5 M15 16l1 1",
};

const downloadLabel = lang === "zh" ? "下载" : "Download";
const detailsLabel = lang === "zh" ? "查看仓库" : "View repo";
---
<section
  id="download"
  data-section="download"
  class="relative overflow-hidden py-32 md:py-40"
>
  <div class="max-w-6xl mx-auto px-6">
    <header class="text-center mb-12 md:mb-16 max-w-2xl mx-auto">
      <p
        data-dl-eyebrow
        class="text-xs font-mono uppercase tracking-[0.25em] text-primary mb-4"
      >
        Get SwarmNote
      </p>
      <h2
        data-dl-h2
        class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground mb-4"
      >
        {t("download.h1")}
      </h2>
      <p data-dl-sub class="text-sm md:text-base text-muted-foreground tabular-nums">
        {subtitleTemplate}
      </p>
    </header>

    <div
      data-dl-grid
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-5"
    >
      {platforms.map((p, i) => (
        <a
          data-dl-tile
          data-tile-index={i}
          href={p.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-disabled={!p.available}
          class:list={[
            "group relative flex flex-col items-center text-center rounded-xl border bg-card p-6 md:p-7 transition-all",
            p.available
              ? "border-border hover:border-primary hover:shadow-xl hover:shadow-primary/15 hover:-translate-y-1"
              : "border-border/60 hover:border-primary/30",
          ]}
        >
          {/* 可用状态指示 */}
          <span
            class:list={[
              "absolute top-3 right-3 w-2 h-2 rounded-full",
              p.available ? "bg-chart-2" : "bg-muted-foreground/40",
            ]}
            aria-hidden="true"
          ></span>

          {/* 平台图标 hex 框 */}
          <div class="relative w-14 h-14 mb-4">
            <svg
              viewBox="-26 -26 52 52"
              class="absolute inset-0 w-full h-full text-primary"
              aria-hidden="true"
            >
              <polygon
                points="22,0 11,19.05 -11,19.05 -22,0 -11,-19.05 11,-19.05"
                fill="currentColor"
                fill-opacity="0.08"
                stroke="currentColor"
                stroke-opacity="0.4"
                stroke-width="1.2"
              />
            </svg>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="absolute inset-0 m-auto w-6 h-6 text-foreground"
              aria-hidden="true"
            >
              <path d={ICON_PATHS[p.key]} />
            </svg>
          </div>

          <h3 class="text-base md:text-lg font-semibold text-foreground mb-1.5">
            {platformsLabel[p.key]}
          </h3>
          {p.available ? (
            <>
              <p class="text-xs font-mono text-muted-foreground tabular-nums mb-3">
                v{p.version ?? RELEASE.version}
              </p>
              {p.fileHint && (
                <p class="text-[11px] text-muted-foreground/80 font-mono mb-4">
                  {p.fileHint}
                </p>
              )}
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-primary group-hover:gap-2 transition-all">
                {downloadLabel}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5"
                  aria-hidden="true"
                >
                  <path d="M5 12h14 M13 6l6 6-6 6" />
                </svg>
              </span>
            </>
          ) : (
            <>
              <p class="text-[11px] text-muted-foreground/80 mb-3 leading-relaxed">
                {p.pendingMsg}
              </p>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground group-hover:text-primary group-hover:gap-2 transition-all">
                {p.pendingLinkLabel ?? detailsLabel}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-3.5 h-3.5"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7 M7 7h10v10" />
                </svg>
              </span>
            </>
          )}
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href={withBase(lang === "zh" ? "/download" : "/en/download")}
        class="inline-flex items-center gap-2 text-sm text-primary hover:underline underline-offset-4 font-medium"
      >
        {t("download.viewAll")}
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="M5 12h14 M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ensureScrollTrigger, prefersReducedMotion } from "../lib/scroll-utils";

  const ScrollTrigger = ensureScrollTrigger();
  const reduced = prefersReducedMotion();

  const root = document.querySelector<HTMLElement>('[data-section="download"]');
  if (root && !reduced) {
    const eyebrow = root.querySelector("[data-dl-eyebrow]");
    const h2 = root.querySelector("[data-dl-h2]");
    const sub = root.querySelector("[data-dl-sub]");
    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-dl-tile]"));

    gsap.set([eyebrow, h2, sub], { y: 24, autoAlpha: 0 });
    gsap.set(tiles, { y: 30, autoAlpha: 0 });

    gsap
      .timeline({
        scrollTrigger: {
          trigger: root,
          start: "top 75%",
          end: "top 20%",
          toggleActions: "play none none reverse",
        },
      })
      .to(eyebrow, { y: 0, autoAlpha: 1, duration: 0.5, ease: "power2.out" })
      .to(h2, { y: 0, autoAlpha: 1, duration: 0.6, ease: "power2.out" }, "-=0.3")
      .to(sub, { y: 0, autoAlpha: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")
      .to(tiles, {
        y: 0,
        autoAlpha: 1,
        duration: 0.55,
        stagger: 0.08,
        ease: "power2.out",
      }, "-=0.2");
  }

  requestAnimationFrame(() => ScrollTrigger.refresh());
</script>
