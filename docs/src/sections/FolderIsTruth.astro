---
/*
  Section 06 — 笔记 = 文件夹 / Your notes stay yours
  - 左：文本叙述
  - 右：终端/文件树 mockup + 兼容工具徽章
*/
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tree = [
  { type: "dir", name: "my-workspace/", depth: 0 },
  { type: "dir", name: ".swarmnote/", depth: 1, dim: true },
  { type: "file", name: "workspace.db", depth: 2, dim: true, ext: "db" },
  { type: "dir", name: "ideas/", depth: 1 },
  { type: "file", name: "p2p-future.md", depth: 2, ext: "md", highlight: true },
  { type: "file", name: "swarm-economics.md", depth: 2, ext: "md" },
  { type: "dir", name: "journal/", depth: 1 },
  { type: "file", name: "2026-04-30.md", depth: 2, ext: "md" },
  { type: "file", name: "README.md", depth: 1, ext: "md" },
];

const tools: { label: string; tag: string }[] = [
  { label: "VS Code", tag: "vscode" },
  { label: "Obsidian", tag: "obsidian" },
  { label: "nvim", tag: "nvim" },
  { label: "Git", tag: "git" },
  { label: "Dropbox", tag: "dropbox" },
  { label: "iCloud", tag: "icloud" },
];
---
<section
  id="folder"
  data-section="folder"
  class="relative overflow-hidden py-32 md:py-40"
>
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
    {/* 左：文案 */}
    <div class="lg:col-span-5">
      <p
        data-folder-eyebrow
        class="text-xs font-mono uppercase tracking-[0.25em] text-primary mb-4"
      >
        Local-first, file-truth
      </p>
      <h2
        data-folder-h2
        class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground mb-5"
      >
        {t("folder.h1")}
      </h2>
      <p
        data-folder-lede
        class="text-base md:text-lg text-muted-foreground leading-relaxed mb-8"
      >
        {t("folder.lede")}
      </p>
      <p
        data-folder-sidenote
        class="text-xs md:text-sm text-muted-foreground italic"
      >
        {t("folder.sidenote")}
      </p>
    </div>

    {/* 右：终端 + 文件树 mockup */}
    <div class="lg:col-span-7">
      <div
        data-folder-terminal
        class="rounded-xl border border-border bg-card shadow-xl shadow-primary/5 overflow-hidden"
      >
        {/* macOS-style 标题栏 */}
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-border bg-muted/40">
          <span class="w-3 h-3 rounded-full bg-destructive/80" aria-hidden="true"></span>
          <span class="w-3 h-3 rounded-full bg-primary/60" aria-hidden="true"></span>
          <span class="w-3 h-3 rounded-full bg-chart-2/70" aria-hidden="true"></span>
          <span class="ml-3 text-xs font-mono text-muted-foreground tracking-wider">~/Documents/my-workspace</span>
        </div>

        <div class="p-5 md:p-6 font-mono text-[13px] md:text-sm leading-7">
          <div class="flex items-center gap-2 text-muted-foreground mb-3">
            <span class="text-primary">$</span>
            <span data-folder-cmd>tree my-workspace --dirs-first -L 2</span>
            <span data-folder-cursor class="inline-block w-1.5 h-4 bg-primary/80 ml-0.5 align-middle"></span>
          </div>

          <ul class="space-y-1">
            {tree.map((node, i) => (
              <li
                data-folder-row
                data-row-index={i}
                class:list={[
                  "flex items-center gap-2 whitespace-nowrap",
                  node.dim && "text-muted-foreground/60",
                  node.highlight && "text-primary",
                  !node.dim && !node.highlight && "text-foreground/85",
                ]}
              >
                <span aria-hidden="true" style={`padding-left:${node.depth * 1.4}rem`}></span>
                {node.type === "dir" ? (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-primary/70 flex-none" aria-hidden="true">
                    <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 flex-none" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8" />
                  </svg>
                )}
                <span>{node.name}</span>
                {node.ext === "md" && (
                  <span class="ml-2 text-[10px] uppercase tracking-widest text-muted-foreground/70">markdown</span>
                )}
              </li>
            ))}
          </ul>

          <div class="mt-5 flex items-center gap-2 text-muted-foreground">
            <span class="text-primary">$</span>
            <span data-folder-cmd2 class="opacity-0">cat ideas/p2p-future.md</span>
          </div>
          <pre data-folder-output class="mt-2 text-foreground/80 text-xs md:text-[13px] leading-6 opacity-0 whitespace-pre-wrap break-words"># P2P 的未来

笔记躺在我自己的硬盘里，
通过 libp2p 在我的设备之间直接同步——
没有服务器，没有账号，没有订阅。</pre>
        </div>
      </div>

      {/* 兼容工具徽章 */}
      <div data-folder-tools class="mt-6 flex flex-wrap gap-2">
        {tools.map((tool) => (
          <span
            class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border"
          >
            {tool.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ensureScrollTrigger, prefersReducedMotion } from "../lib/scroll-utils";

  const ScrollTrigger = ensureScrollTrigger();
  const reduced = prefersReducedMotion();

  const root = document.querySelector<HTMLElement>('[data-section="folder"]');
  if (root) {
    const eyebrow = root.querySelector("[data-folder-eyebrow]");
    const h2 = root.querySelector("[data-folder-h2]");
    const lede = root.querySelector("[data-folder-lede]");
    const sidenote = root.querySelector("[data-folder-sidenote]");
    const terminal = root.querySelector("[data-folder-terminal]");
    const rows = Array.from(root.querySelectorAll<HTMLElement>("[data-folder-row]"));
    const cursor = root.querySelector<HTMLElement>("[data-folder-cursor]");
    const cmd2 = root.querySelector<HTMLElement>("[data-folder-cmd2]");
    const output = root.querySelector<HTMLElement>("[data-folder-output]");
    const tools = root.querySelector("[data-folder-tools]");

    if (reduced) {
      if (cmd2) cmd2.style.opacity = "1";
      if (output) output.style.opacity = "1";
    } else {
      gsap.set([eyebrow, h2, lede, sidenote], { y: 24, autoAlpha: 0 });
      gsap.set(terminal, { y: 30, autoAlpha: 0, scale: 0.97, transformOrigin: "center" });
      gsap.set(rows, { x: -8, autoAlpha: 0 });
      gsap.set(tools, { y: 20, autoAlpha: 0 });

      gsap
        .timeline({
          scrollTrigger: {
            trigger: root,
            start: "top 70%",
            end: "top 10%",
            toggleActions: "play none none reverse",
          },
        })
        .to(eyebrow, { y: 0, autoAlpha: 1, duration: 0.5, ease: "power2.out" })
        .to(h2, { y: 0, autoAlpha: 1, duration: 0.6, ease: "power2.out" }, "-=0.3")
        .to(lede, { y: 0, autoAlpha: 1, duration: 0.5, ease: "power2.out" }, "-=0.4")
        .to(sidenote, { y: 0, autoAlpha: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")
        .to(terminal, { y: 0, autoAlpha: 1, scale: 1, duration: 0.7, ease: "power2.out" }, "-=0.5")
        .to(rows, {
          x: 0,
          autoAlpha: 1,
          duration: 0.3,
          stagger: 0.05,
          ease: "power1.out",
        }, "-=0.2")
        .to(cmd2, { autoAlpha: 1, duration: 0.4, delay: 0.2 })
        .to(output, { autoAlpha: 1, duration: 0.5 }, "-=0.1")
        .to(tools, { y: 0, autoAlpha: 1, duration: 0.5 }, "-=0.3");

      // 终端光标闪烁
      if (cursor) {
        gsap.to(cursor, {
          autoAlpha: 0.2,
          duration: 0.55,
          repeat: -1,
          yoyo: true,
          ease: "steps(1)",
        });
      }
    }
  }

  requestAnimationFrame(() => ScrollTrigger.refresh());
</script>
